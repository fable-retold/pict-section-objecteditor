{
	"ConfigData":
	{
		"application":
		{
			"name":          "Object Editor Playground",
			"version":       "1.0.0",
			"debug":         false,
			"port":          8080,
			"maxConnections": 1000,
			"features":      ["json-tree", "inline-edit", "type-badges"],
			"database":
			{
				"host": "localhost",
				"port": 5432,
				"ssl":  true,
				"pool": { "min": 2, "max": 10 }
			},
			"logging":
			{
				"level":     "info",
				"format":    "json",
				"colorize":  true
			},
			"metadata":
			{
				"author":   "Retold",
				"tags":     ["demo", "playground", "object-editor"],
				"license":  "MIT"
			}
		}
	}
}
